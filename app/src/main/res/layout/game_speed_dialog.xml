<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Labels beside the spinners, as in input_controls_dialog: this opens over a running game
             in landscape, where stacked rows scroll away. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="@string/game_speed" />

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SSpeedMode"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="@string/fast_forward" />

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SFastForwardSpeed"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="@string/slow_motion" />

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SSlowMotionSpeed"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/CBShowSpeedNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/show_speed_notification" />

        <TextView
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:alpha="0.7"
            android:text="@string/game_speed_help" />
    </LinearLayout>
</ScrollView>
